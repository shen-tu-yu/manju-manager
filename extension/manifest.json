{
  "manifest_version": 3,
  "name": "投放素材助手 · 豆包 / DeepSeek / Pavo",
  "version": "1.2.0",
  "description": "在豆包 / DeepSeek / Pavo 页面加一个素材侧边栏，从本地素材库点一下就把文件送进输入框",
  "content_scripts": [
    {
      "matches": [
        "https://www.doubao.com/*",
        "https://doubao.com/*",
        "https://chat.deepseek.com/*",
        "https://www.deepseek.com/*",
        "https://app.pavo-ai.work/*",
        "https://*.pavo-ai.work/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ]
}
